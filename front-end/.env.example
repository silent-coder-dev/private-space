# Only needed if the website and the relay server live on different addresses.
# By default the app connects to the same site it was loaded from (wss://<site>/ws).
# VITE_SYNC_URL=wss://your-relay.example.com/ws

# Optional TURN server so calls also work on strict mobile networks.
# VITE_TURN_URL=turn:your-turn-host:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

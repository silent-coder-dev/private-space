# ───────────── Server settings (set them on your host, e.g. Render → Environment) ─────────────
# Nothing here is required. Calls, chat and everything else work without any of them.

# Behind a proxy (Render, Railway, Fly.io…): use the real visitor IP for rate limits.
# TRUST_PROXY=1

# Calls on strict mobile networks — a free TURN relay (pick ONE option):
#  a) Cloudflare Realtime TURN (the first 1,000 GB each month are free):
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
#  b) Any TURN service with fixed credentials (Metered / Open Relay, ExpressTURN, your own coturn…):
# TURN_URLS=turn:your-turn-host:3478,turns:your-turn-host:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
# Without TURN, a call that can't connect directly goes through the UsSpace server instead (still encrypted).

# Free database (Upstash Redis) so "Close room" and the 2-device lock survive server restarts.
# It stores only "this room is closed" and "these two devices own this room" — never messages or photos.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# ───────────── Build settings (only if the website and the relay live on different addresses) ─────────────
# VITE_SYNC_URL=wss://your-relay.example.com/ws
